# Reverse proxy / TLS termination — the only compose service with published
# ports, per MASTER_PROMPT.md §8.1.
#
# {$APP_URL} is expected to be a real hostname (e.g. internship.scit.bnu.edu.pk)
# for automatic HTTPS via Caddy's built-in ACME support on a machine reachable
# from the internet. For a campus-network-only deployment with no public DNS,
# replace {$APP_URL} with the internal hostname/IP and add `tls internal` to
# the site block below to use Caddy's local CA instead — do not remove TLS
# entirely; the master prompt requires HTTPS either way.
{$APP_URL:localhost} {
	reverse_proxy app:3000

	encode zstd gzip

	header {
		# M14/§9: CSP (with its per-request script nonce), X-Content-Type-
		# Options, X-Frame-Options, Referrer-Policy and Permissions-Policy
		# are all set by src/middleware.ts instead of here — the nonce is
		# generated per-request by the app itself, so those headers have
		# to originate there, not at this static reverse-proxy layer. HSTS
		# is the one exception: it belongs at the TLS-terminating hop
		# (this is the only service with published ports/real TLS), and a
		# browser only honors it in the first place once a connection has
		# already arrived over HTTPS, which is decided here, not in Next.
		#
		# 31536000s = 1 year. includeSubDomains since {$APP_URL} is not
		# expected to host unrelated subdomains that would need to opt
		# out. `preload` deliberately omitted — submission to browsers'
		# HSTS preload list is a one-way, hard-to-reverse operational
		# step (removal takes months to propagate) that shouldn't be taken
		# as a side effect of a header default; see D-093 in docs/DECISIONS.md.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output stdout
		format json
	}
}
