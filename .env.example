# Copy to .env and fill in every value. Never commit .env. File permissions
# should be 600 on the deployment host. Full reference: MASTER_PROMPT.md §8.2.

# ---- Application ----
NODE_ENV=
# Public URL the app is served at (also used by Caddy for automatic HTTPS).
APP_URL=
# Session signing secret — long, random, generated once per deployment.
# e.g. `openssl rand -base64 48`
SESSION_SECRET=

# ---- Database ----
# Connection string the running app uses. Points at the runtime role,
# scit_app (INSERT/SELECT/UPDATE/DELETE on ordinary tables, INSERT/SELECT
# only on audit_events/case_events, INSERT/SELECT only on grades, no DDL)
# — see docs/modules/M01.md. Password matches DATABASE_APP_ROLE_PASSWORD
# below, once scripts/db/provision-runtime-role.sh has set it.
DATABASE_URL=
# Connection string used only during `prisma migrate deploy` (and by
# scripts/db/provision-runtime-role.sh). Points at the migration role,
# which owns the schema and creates/grants scit_app. Never used by
# app/worker at runtime.
DATABASE_MIGRATION_ROLE=
# Runtime role name. Fixed to "scit_app" by the init migration (see
# prisma/migrations/*_init/migration.sql) — documented here rather than
# read from this value, since a migration file can't be templated by an
# env var. Kept for operator reference and for scripts that want to name
# it without hard-coding a second copy of the string.
DATABASE_APP_ROLE=scit_app
# The runtime role's password. The role itself is created by the init
# migration with no password set (so nothing sensitive is ever committed
# to that file); run scripts/db/provision-runtime-role.sh after migrating
# to actually set it to this value.
DATABASE_APP_ROLE_PASSWORD=
# Compose-only: credentials for the postgres container's bootstrap
# superuser (this is who DATABASE_MIGRATION_ROLE connects as).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---- Redis / jobs ----
REDIS_URL=

# ---- Mail (BNU SMTP relay — no third-party mail service) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- File uploads ----
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
ALLOWED_MIME=application/pdf,image/jpeg,image/png

# ---- Antivirus scanning ----
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- Policy configuration (see MASTER_PROMPT.md §4 for the rules these back) ----
SUPERVISOR_TOKEN_TTL_DAYS=21
SLA_DAYS=10
SUPERVISOR_SLA_DAYS=14
RESTART_CAP=1
MIN_INTERNSHIP_WEEKS=4
MAX_INTERNSHIP_WEEKS=8
COMPANY_MATCH_THRESHOLD=0.85

# ---- Backups ----
BACKUP_RETENTION_DAYS=30
# Compose-only: how often the backup sidecar's loop runs, in seconds.
BACKUP_INTERVAL_SECONDS=3600
