# Copy to .env and fill in every value. Never commit .env. File permissions
# should be 600 on the deployment host. Full reference: MASTER_PROMPT.md §8.2.

# ---- Application ----
NODE_ENV=
# Public URL the app is served at (also used by Caddy for automatic HTTPS).
APP_URL=
# Session signing secret — long, random, generated once per deployment.
# e.g. `openssl rand -base64 48`
SESSION_SECRET=

# ---- Database ----
# Connection string the running app uses. Points at the runtime role
# (INSERT/SELECT/UPDATE/DELETE on ordinary tables, INSERT/SELECT only on
# audit_events and case_events, no DDL) — see docs/modules/M01.md.
DATABASE_URL=
# Connection string used only during `prisma migrate deploy`. Points at the
# migration role, which owns the schema. Never used by app/worker at runtime.
DATABASE_MIGRATION_ROLE=
# Runtime role name (used by M01's grant script to know which role to
# restrict — not a connection string).
DATABASE_APP_ROLE=
# Compose-only: credentials for the postgres container's default superuser,
# used to create the two roles above during first-run provisioning.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---- Redis / jobs ----
REDIS_URL=

# ---- Mail (BNU SMTP relay — no third-party mail service) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ---- File uploads ----
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
ALLOWED_MIME=application/pdf,image/jpeg,image/png

# ---- Antivirus scanning ----
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ---- Policy configuration (see MASTER_PROMPT.md §4 for the rules these back) ----
SUPERVISOR_TOKEN_TTL_DAYS=21
SLA_DAYS=10
SUPERVISOR_SLA_DAYS=14
RESTART_CAP=1
MIN_INTERNSHIP_WEEKS=4
MAX_INTERNSHIP_WEEKS=8
COMPANY_MATCH_THRESHOLD=0.85

# ---- Backups ----
BACKUP_RETENTION_DAYS=30
# Compose-only: how often the backup sidecar's loop runs, in seconds.
BACKUP_INTERVAL_SECONDS=3600
